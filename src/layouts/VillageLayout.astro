---
// WebtrES Village — Ekoparty · Buenos Aires · 2026
import { getRelativeLocaleUrl } from "astro:i18n";
import { activities, days, talks, triviaTimes, venue } from "../data/schedule";
import { attribution, event, socials } from "../data/village";
import { languages, type Lang } from "../i18n/ui";
import { formatDateSpan, formatDay, talkKey, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const renderedAt = Date.now();
const when = formatDateSpan(days[0].date, days[days.length - 1].date, lang);
const agenda = days.map((day) => ({
  n: day.n,
  date: day.date,
  label: formatDay(day.date, lang),
  talks: talks.filter((talk) => talk.day === day.n),
}));
const triviaSlots = days.flatMap((day) => triviaTimes.map((time) => ({
  startsAt: Date.parse(`${day.date}T${time}:00-03:00`),
  label: t("activity.trivia.next", { when: `${formatDay(day.date, lang)} · ${time}` }),
})));
const nextTrivia = triviaSlots.find((slot) => slot.startsAt > renderedAt);
const calendarBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const localeUrls = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: code,
  name: languages[code],
  href: getRelativeLocaleUrl(code),
}));

// Social scrapers do not resolve relative URLs, so these must be absolute. `Astro.site`
// comes from `site` in astro.config.mjs.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/assets/og-card.png", Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/gif" href="/assets/favicon.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{t("meta.title", { year: event.year })}</title>
    <meta name="description" content={t("meta.description", { year: event.year })} />
    <meta name="theme-color" content="#0d0d0d" />

    <link rel="canonical" href={canonicalUrl.href} />
    {
      localeUrls.map((l) => (
        <link rel="alternate" hreflang={l.code} href={new URL(l.href, Astro.site).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl("es"), Astro.site).href}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_AR" : "en_US"} />
    <meta property="og:site_name" content={`${event.title} — ${event.edition}`} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={t("meta.title", { year: event.year })} />
    <meta
      property="og:description"
      content={t("meta.ogDescription", { year: event.year })}
    />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={t("meta.ogImageAlt", { year: event.year })}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("meta.title", { year: event.year })} />
    <meta
      name="twitter:description"
      content={t("meta.ogDescription", { year: event.year })}
    />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta
      name="twitter:image:alt"
      content={t("meta.ogImageAlt", { year: event.year })}
    />
  </head>

  <body>
    <div class="scanlines" aria-hidden="true"></div>

    <main class="stage">
      <section class="terminal" aria-label={t("terminal.aria")}>
        <header class="term-bar">
          <span class="dots" aria-hidden="true">
            <span class="dot dot--r"></span>
            <span class="dot dot--y"></span>
            <span class="dot dot--g"></span>
          </span>
          <span class="term-title">webtres@ekoparty:~</span>
          <span class="term-spacer" aria-hidden="true"></span>
          <nav class="lang" aria-label={t("lang.aria")}>
            {
              localeUrls.map((l) => (
                <a
                  class="lang-link"
                  href={l.href}
                  hreflang={l.code}
                  lang={l.code}
                  title={l.name}
                  aria-current={l.code === lang ? "true" : undefined}
                >
                  {l.label}
                </a>
              ))
            }
          </nav>
        </header>

        <div class="term-body">
          <figure class="hero">
            <img
              class="pixelated"
              src="/assets/UwUloscopio_big.gif"
              alt={t("hero.alt")}
              width="288"
              height="240"
              loading="eager"
              decoding="async"
            />
          </figure>

          <div class="chips">
            <span class="chip">{event.edition}</span>
            <span class="chip">{event.city}</span>
            <span class="chip">{event.year}</span>
          </div>

          <h1 class="title">
            WebtrES <span class="title-accent">Village</span>
          </h1>

          <p class="tagline">
            {t("tagline.line1")}<br class="br-md" />{" "}{t("tagline.line2")}
          </p>

          <nav class="socials" aria-label={t("socials.aria")}>
            {
              socials.map((s) => (
                <a
                  class="btn btn--ghost"
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {s.label}
                </a>
              ))
            }
          </nav>

          <div class="console schedule" role="region" aria-label={t("schedule.aria")}>
            <p class="line">
              <span class="prompt">$</span> ./agenda
            </p>
            <div class="schedule-tabs" role="tablist" aria-label={t("schedule.tabsAria")} hidden>
              <button
                class="btn schedule-tab"
                type="button"
                id="tab-talks"
                role="tab"
                aria-controls="panel-talks"
                aria-selected="true"
              >
                {t("schedule.talks")}
              </button>
              <button
                class="btn schedule-tab"
                type="button"
                id="tab-activities"
                role="tab"
                aria-controls="panel-activities"
                aria-selected="false"
                tabindex="-1"
              >
                {t("schedule.activities")}
              </button>
            </div>
            <section class="schedule-panel" id="panel-talks" aria-labelledby="tab-talks">
            <h2 class="panel-title">{t("schedule.talks")}</h2>
            <p class="line status">
              <span class="bracket">[</span>
              <span class="status-text">{t("schedule.status")}</span>
              <span class="bracket">]</span>
            </p>
            <p class="line muted">
              <span class="prompt">&gt;</span>
              {t("schedule.note", { when, venue })}
            </p>
            {
              t("schedule.langNote") && (
                <p class="line muted">
                  <span class="prompt">&gt;</span>
                  {t("schedule.langNote")}
                </p>
              )
            }
            <a
              class="btn btn--primary schedule-add schedule-add-all"
              href={`${calendarBase}calendar/${lang}/all.ics`}
              download="webtres-all.ics"
            >
              <span class="prompt" aria-hidden="true">$</span>
              {t("schedule.addAll")}
            </a>
            {
              agenda.map((day) => (
                <div class="day">
                  <p class="day-label">
                    <span class="prompt">#</span>
                    {t("schedule.day", { n: day.n })}
                    <span class="day-date">{day.label}</span>
                  </p>
                  {day.talks.map((talk) => {
                    const title = t(talkKey(talk.id, "title"));
                    const completed = Date.parse(`${day.date}T${talk.end}:00-03:00`) <= renderedAt;
                    const live = Date.parse(`${day.date}T${talk.start}:00-03:00`) <= renderedAt && !completed;
                    return (
                      <article class:list={["talk", { "talk--completed": completed, "talk--live": live }]} id={talk.id}>
                        <p class="talk-meta">
                          <time datetime={`${day.date}T${talk.start}:00-03:00`}>{talk.start}</time>
                          {" – "}
                          <time datetime={`${day.date}T${talk.end}:00-03:00`}>{talk.end}</time>
                          <span class="talk-dot" aria-hidden="true">·</span>
                          <span>{t("schedule.room", { room: talk.room })}</span>
                          <span class="talk-dot" aria-hidden="true">·</span>
                          <span>{t("schedule.kind")}</span>
                          <span class="talk-live" hidden={!live}>{t("schedule.live")}</span>
                          <span class="talk-completed" hidden={!completed}>
                            <span class="talk-dot" aria-hidden="true">·</span>
                            {t("schedule.completed")}
                          </span>
                        </p>
                        <h2 class="talk-title">{title}</h2>
                        <p class="talk-speaker">{talk.speaker}</p>
                        <p class="talk-desc">{t(talkKey(talk.id, "description"))}</p>
                        <a
                          class="btn btn--primary schedule-add"
                          href={`${calendarBase}calendar/${lang}/${talk.id}.ics`}
                          download={`webtres-${talk.id}.ics`}
                          aria-label={t("schedule.addAria", { title })}
                        >
                          <span class="prompt">$</span>
                          {t("schedule.add")}
                        </a>
                      </article>
                    );
                  })}
                </div>
              ))
            }
            </section>
            <section class="schedule-panel" id="panel-activities" aria-labelledby="tab-activities">
              <h2 class="panel-title">{t("schedule.activities")}</h2>
              <div class="activities">
                {activities.map((id) => (
                  <article class="activity" id={id}>
                    <div class="activity-heading">
                      <h3 class="talk-title">{t(`activity.${id}.title`)}</h3>
                      {id !== "trivia" && (
                        <span class="talk-live activity-live">{t("schedule.live")}</span>
                      )}
                    </div>
                    <p class="talk-desc">{t(`activity.${id}.description`)}</p>
                    {id === "trivia" && (
                      <>
                        <p class="activity-schedule">
                          {t("activity.trivia.schedule", { start: triviaTimes[0], end: triviaTimes[triviaTimes.length - 1] })}
                        </p>
                        <p
                          class="activity-schedule trivia-next"
                          data-slots={JSON.stringify(triviaSlots)}
                          data-no-upcoming={t("activity.trivia.noUpcoming")}
                        >
                          {nextTrivia?.label ?? t("activity.trivia.noUpcoming")}
                        </p>
                      </>
                    )}
                  </article>
                ))}
              </div>
            </section>
          </div>

        </div>
      </section>

      <footer class="foot">
        <span>
          {attribution.webtres} x <a
            class="foot-link"
            href={attribution.trg.href}
            target="_blank"
            rel="noopener noreferrer">{attribution.trg.label}</a
          >
        </span>
        <span class="foot-sep" aria-hidden="true">·</span>
        <span>{t("footer.tagline")}</span>
      </footer>
    </main>
  </body>
</html>

<script>
  const schedule = document.querySelector<HTMLElement>(".schedule");
  if (schedule) {
    const talkElements = Array.from(schedule.querySelectorAll<HTMLElement>(".talk")).map((element) => ({
      element,
      startsAt: Date.parse(element.querySelector<HTMLTimeElement>("time:first-of-type")!.dateTime),
      endsAt: Date.parse(element.querySelector<HTMLTimeElement>("time:last-of-type")!.dateTime),
      completedLabel: element.querySelector<HTMLElement>(".talk-completed")!,
      liveLabel: element.querySelector<HTMLElement>(".talk-live")!,
    }));
    const triviaElement = schedule.querySelector<HTMLElement>(".trivia-next")!;
    const triviaSlots = JSON.parse(triviaElement.dataset.slots!) as { startsAt: number; label: string }[];
    let stateTimer: ReturnType<typeof setTimeout> | undefined;

    function updateScheduleStates() {
      clearTimeout(stateTimer);
      const now = Date.now();
      let nextChange = Infinity;
      for (const talk of talkElements) {
        const completed = talk.endsAt <= now;
        const live = talk.startsAt <= now && !completed;
        talk.element.classList.toggle("talk--completed", completed);
        talk.element.classList.toggle("talk--live", live);
        talk.completedLabel.hidden = !completed;
        talk.liveLabel.hidden = !live;
        if (talk.startsAt > now) nextChange = Math.min(nextChange, talk.startsAt);
        else if (!completed) nextChange = Math.min(nextChange, talk.endsAt);
      }
      const nextTrivia = triviaSlots.find((slot) => slot.startsAt > now);
      triviaElement.textContent = nextTrivia?.label ?? triviaElement.dataset.noUpcoming!;
      if (nextTrivia) nextChange = Math.min(nextChange, nextTrivia.startsAt);
      if (nextChange !== Infinity) {
        stateTimer = setTimeout(updateScheduleStates, Math.min(nextChange - now, 2_147_483_647));
      }
    }

    updateScheduleStates();
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) updateScheduleStates();
    });

    const tablist = schedule.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")!)!);

    function selectTab(index: number) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        switch (event.key) {
          case "ArrowRight": next = (index + 1) % tabs.length; break;
          case "ArrowLeft": next = (index + tabs.length - 1) % tabs.length; break;
          case "Home": next = 0; break;
          case "End": next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        selectTab(next);
        tabs[next].focus();
      });
    });

    panels.forEach((panel) => {
      panel.setAttribute("role", "tabpanel");
      panel.tabIndex = 0;
    });
    selectTab(0);
    schedule.dataset.tabsReady = "";
    tablist.hidden = false;
  }
</script>

<style is:global>
  :root {
    /* DESIGN.md tokens */
    --primary: #94d1ad;
    --secondary: #222a26;
    --tertiary: #374151;
    --neutral: #0d0d0d;
    --surface: #111111;
    --accent: #ffffff;
    --error: #ff6b6b;

    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;

    --radius-md: 6px;
    --radius-lg: 8px;
    --radius-xl: 12px;
    --radius-full: 9999px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    background-color: var(--neutral);
    /* subtle terminal vignette — flat, no glossy gradients */
    background-image: radial-gradient(
      120% 90% at 50% 0%,
      rgba(148, 209, 173, 0.05),
      transparent 55%
    );
    color: var(--primary);
    font-family: var(--font-mono);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--primary);
    color: var(--neutral);
  }
</style>

<style>
  .stage {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;
    gap: 24px;
    padding: 24px 16px;
  }

  /* Terminal panel — card treatment from DESIGN.md */
  .terminal {
    width: 100%;
    max-width: 720px;
    background-color: var(--surface);
    border: 1px solid rgba(148, 209, 173, 0.3);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background-color: var(--secondary);
    border-bottom: 1px solid rgba(148, 209, 173, 0.15);
  }

  .dots {
    display: inline-flex;
    gap: 6px;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: var(--radius-full);
    display: inline-block;
    opacity: 0.85;
  }
  .dot--r {
    background: var(--error);
  }
  .dot--y {
    background: #e5c07b;
  }
  .dot--g {
    background: var(--primary);
  }

  .term-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--primary);
    opacity: 0.75;
    letter-spacing: 0.02em;
    /* Yield to the language switcher on narrow screens instead of clipping it. */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .term-spacer {
    flex: 1;
  }

  /* Language switcher — reads as a terminal flag list */
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex: none;
  }

  .lang-link {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    text-decoration: none;
    color: var(--primary);
    opacity: 0.5;
    padding: 3px 7px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .lang-link:hover {
    opacity: 1;
    border-color: rgba(148, 209, 173, 0.25);
    background-color: rgba(148, 209, 173, 0.06);
  }

  .lang-link[aria-current="true"] {
    opacity: 1;
    color: var(--accent);
    border-color: rgba(148, 209, 173, 0.35);
    background-color: rgba(148, 209, 173, 0.08);
  }

  .lang-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .term-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 40px 24px 32px;
  }

  /* Pixel-art hero */
  .hero {
    margin: 0;
    padding: 0;
  }

  .pixelated {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    width: 160px;
    height: auto;
    display: block;
  }

  /* Chips / tags */
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .chip {
    background-color: var(--secondary);
    color: var(--primary);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    border-radius: var(--radius-full);
    padding: 4px 10px;
    border: 1px solid rgba(148, 209, 173, 0.18);
  }

  .title {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(34px, 8vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--primary);
  }

  .title-accent {
    color: var(--accent);
  }

  .tagline {
    margin: 0;
    max-width: 46ch;
    font-size: 16px;
    line-height: 26px;
    color: var(--primary);
    opacity: 0.72;
  }

  /* Console block */
  .console {
    width: 100%;
    max-width: 420px;
    text-align: left;
    background-color: var(--neutral);
    border: 1px solid rgba(148, 209, 173, 0.18);
    border-radius: var(--radius-lg);
    padding: 16px;
    margin-top: 4px;
  }

  .line {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .line + .line {
    margin-top: 6px;
  }

  .prompt {
    color: var(--primary);
    opacity: 0.6;
    margin-right: 6px;
  }

  .status {
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: normal;
  }

  .bracket {
    color: var(--primary);
    opacity: 0.55;
  }

  .status-text {
    color: var(--accent);
    padding: 0 6px;
  }

  .muted {
    color: var(--primary);
    opacity: 0.55;
    white-space: normal;
  }

  /* Confirmed agenda */
  .schedule {
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }
  .schedule .line {
    white-space: normal;
  }
  .schedule .line + .line {
    margin-top: 0;
  }
  .schedule-tabs {
    display: flex;
    gap: 4px;
    margin: 8px 0 12px;
    border-bottom: 1px solid rgba(148, 209, 173, 0.15);
  }
  .schedule-tab {
    min-height: 44px;
    background: transparent;
    color: var(--primary);
    border: 1px solid transparent;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .schedule-tab:hover {
    background: var(--secondary);
    color: var(--accent);
  }
  .schedule-tab[aria-selected="true"] {
    background: var(--secondary);
    color: var(--accent);
    border-bottom-color: var(--primary);
  }
  .schedule-tab:active {
    color: var(--primary);
  }
  .schedule-tabs[hidden],
  .schedule-panel[hidden],
  .schedule[data-tabs-ready] .panel-title {
    display: none;
  }
  .schedule-panel {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .schedule-panel:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }
  .panel-title {
    font-size: 16px;
  }
  .activities {
    display: flex;
    flex-direction: column;
    margin-top: 16px;
  }
  .activity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 14px 0;
    border-top: 1px solid rgba(148, 209, 173, 0.15);
  }
  .activity-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .activity .activity-live {
    margin-left: 0;
  }
  .activity-schedule {
    margin: 0;
    font-size: 12px;
    line-height: 18px;
    color: var(--primary);
    opacity: 0.75;
  }
  .day {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgba(148, 209, 173, 0.15);
  }
  .day-label {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: 0.03em;
    color: #e5c07b;
  }
  .day-label .prompt {
    color: #e5c07b;
    opacity: 0.8;
  }
  .day-date {
    color: var(--primary);
    opacity: 0.7;
    margin-left: 8px;
  }
  .talk {
    display: flex;
